{
  "manifest_version": 3,
  "name": "Tab Triage",
  "version": "1.0",
  "minimum_chrome_version": "121",
  "description": "Filter and group open tabs and find candidates to close.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tab Triage" }
}
